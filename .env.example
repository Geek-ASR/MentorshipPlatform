# Copy to .env.local for local development. Never commit real values.
# All variables are validated at startup (src/config/env.ts); the app refuses to start if invalid.

# --- Runtime environment -------------------------------------------------------
# local | test | preview | staging | production
APP_ENV=local
# Public origin of the app (used for CSRF/Origin checks, links, cookies)
APP_BASE_URL=http://localhost:3000
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Database ------------------------------------------------------------------
# Local Postgres 16+. Runtime role for the app.
DATABASE_URL=postgres://postgres@localhost:5432/aheadly_dev
# Set to false when connecting through a transaction pooler (e.g. Supabase port 6543)
DATABASE_PREPARED_STATEMENTS=true
DATABASE_POOL_MAX=5
# Used only by migrations/admin scripts (can equal DATABASE_URL locally)
DATABASE_MIGRATOR_URL=postgres://postgres@localhost:5432/aheadly_dev
# Admin connection used by the integration-test harness to create throwaway databases
TEST_DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# --- Internal endpoints ----------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_TICK_SECRET=
OPS_SECRET=

# --- Networking ------------------------------------------------------------------
# Header set by your host containing the real client IP (e.g. x-real-ip, cf-connecting-ip).
# Leave empty locally; never trust a header your host does not overwrite.
CLIENT_IP_HEADER=
